{
  "name": "little-workshop",
  "version": "1.1.0",
  "description": "Proje ilerleme takibi",
  "author": "Eyüp Özdal",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.eyup.littleworkshop",
    "productName": "Little Workshop",
    "files": [
      "main.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Little Workshop",
      "artifactName": "LittleWorkshop-Setup-${version}.exe"
    }
  }
}

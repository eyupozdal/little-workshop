{
  "name": "little-workshop",
  "version": "1.1.0",
  "description": "Proje ilerleme takibi",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.eyup.littleworkshop",
    "productName": "Little Workshop",
    "files": ["main.js", "index.html", "package.json"],
    "win": {
      "target": ["portable"]
    },
    "portable": {
      "artifactName": "LittleWorkshop-${version}.exe"
    }
  }
}
